{
  "name": "teaching-apis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:worker": "opennextjs-cloudflare build && wrangler deploy --dry-run",
    "preview:worker": "npm run build:worker && opennextjs-cloudflare preview",
    "deploy:worker": "npm run build:worker && opennextjs-cloudflare deploy",
    "typegen:worker": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "framer-motion": "^12.12.1",
    "json-diff-kit": "^1.0.35",
    "next": "16.2.11",
    "next-intl": "^4.9.1",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.372.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^2.15.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260809.1",
    "@opennextjs/cloudflare": "1.20.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.27.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5",
    "wrangler": "4.120.0"
  }
}
